#########################################################################
######################Weighted K-class LDA
##########################################################################
lda_w_fit <- function(X, gi, K, w , prior = rep(1 / K, K)) {
  # X: n x p data matrix, gi: class index vector with vals 1:K, w: non-negative weights (must sum up to n)
  X <- as.matrix(X)
  p <- ncol(X)
  M <- matrix(0, p, K)                       # matrix of covariate means per class
  S <- matrix(0, p, p)                       # pooled within-class scatter
  class_weight <- numeric(K)

  for (k in 1:K){
    idx <- gi == k
    class_weight[k] <- sum(w[idx])
    M[, k] <- colSums(X[idx, , drop = FALSE] * w[idx]) / class_weight[k]
    Xc <- sweep(X[idx, , drop = FALSE], 2, M[, k]) #matrix with rows(x_i-m_k)
    S <- S + crossprod(Xc * sqrt(w[idx]))
  }
  S <- S / max(sum(w) - K, 1)

  Sinv <- tryCatch(solve(S), error = function(e) MASS::ginv(S))
  V  <- Sinv %*% M                           # p x K
  b0 <- -0.5 * colSums(M * V) + log(prior)

  return(list(V = V, b0 = b0))
}

########Scores and single-classifier predictions
lda_w_scores  <- function(fit, X) sweep(as.matrix(X) %*% fit$V, 2, fit$b0, "+")
lda_w_predict <- function(fit, X) max.col(lda_w_scores(fit, X), ties.method = "first")

#####################################################
#############Boosting
#####################################################

boost_lda_w <- function(X, y, E = 250, prior = NULL, max_restarts = 25, verbose = FALSE) {
  X <- as.matrix(X)
  n <- nrow(X)
  g <- factor(y)
  classes <- levels(g)
  K <- length(classes)
  gi <- as.integer(g)

  if (K < 2){stop("Insufficient amount of classes in training data: ", K)}
  if (is.null(prior)) prior <- rep(1 / K, K)

  err_max <- 0.5

  w <- rep(1, n) #weights sum to n
  fit_vec <- vector("list", E)
  vw_vec  <- numeric(E)
  b <- 0
  rest <- 0

  while (b < E){
    fit <- lda_w_fit(X, gi, K, w, prior)
    psi_i  <- as.numeric(lda_w_predict(fit, X) != gi)   # 1 = misclassified
    err <- sum(w * psi_i) / n      
      
    if (verbose){message(sprintf("b = %3d  err = %.4f", b + 1, err))}

    if (err == 0 && b == 0){
      b <- 1
      fit_vec[[1]] <- fit
      vw_vec[1] <- 1
      warning("Training error is 0 at the first round; using a single classifier.")
      break
    }

    if (err > 0 && err < err_max){
      b <- b + 1
      cb <- 0.5 * log((1 - err) / err)
      fit_vec[[b]] <- fit
      vw_vec[b] <- cb
      w <- w * exp(cb * psi_i)
      w <- w * n / sum(w) # make sure sum = n
      next
    }
    rest <- rest + 1
    if (rest > max_restarts){
      warning("Too many restarts (err = 0 or too large); stopping with ", b, " classifiers.")
      break
    }
    repeat{
      w <- as.numeric(rmultinom(1, n, rep(1 / n, n)))
      if (all(tapply(w, gi, sum) > 0)) break
    }
  }

  output<- list(fits = fit_vec[seq_len(b)], c = vw_vec[seq_len(b)],
                 classes = classes)
  class(output) <- "boost_lda_w"
  return(output)
}
###############################
#####Decision (weighted voting)
###############################
predict.boost_lda_w <- function(object, newdata, ...) {
  X <- as.matrix(newdata)
  K <- length(object$classes)
  votes <- matrix(0, nrow(X), K)
  for (b in seq_along(object$fits)) {
    pred_b  <- lda_w_predict(object$fits[[b]], X)
    idx <- cbind(seq_len(nrow(X)), pred_b)
    votes[idx] <- votes[idx] + object$c[b]
  }
  
  final_pred <- factor(object$classes[max.col(votes, ties.method = "first")],
         levels = object$classes)

  return(final_pred)
}
