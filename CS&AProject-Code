sokolova_measures <- function(cm) {
  N  <- sum(cm)
  tp <- diag(cm)
  fp <- colSums(cm) - tp
  fn <- rowSums(cm) - tp 
  tn <- N - tp - fp - fn

  safe <- function(a, b){ifelse(b == 0, 0, a / b)} 
  F1s <- function(P, R){safe(2 * P * R , P + R)}

  P_mu <- sum(tp) / sum(tp + fp)
  R_mu <- sum(tp) / sum(tp + fn)
  P_M  <- mean(tp / (tp + fp), na.rm = TRUE)
  R_M  <- mean(tp / (tp + fn), na.rm = TRUE)

  c("Avg Accuracy" = mean((tp + tn) / N),
    "Error Rate"   = mean((fp + fn) / N),
    "Micro-avg precision"= P_mu, "Micro-avg recall" = R_mu, "Micro-avg F1-score" = F1s(P_mu, R_mu),
    "Macro-avg precision"  = P_M,  "Macro-avg recall" = R_M,  "Macro-avg F1-score"  = F1s(P_M, R_M))
}


