#####KNN-Boosting
################################################
####Selection of k per cluster function####
#####################################
select_k <- function(Xc, yc, orig_idx, k_grid = c(1, 5, length(unique(y)), 15, 25), m_folds){
  if (length(unique(yc)) == 1)                        # case where cluster has one class
    return(list(flag_const_class = as.character(yc[1]), k = NA))

  idxs   <- unique(orig_idx)  
  n_eff <- length(idxs)                                # number of distinct observations
  cand_k_vec  <- sort(unique(k_grid[k_grid >= 1 & k_grid <= n_eff]))
  if (length(cand_k_vec) == 0) {cand <- n_eff}
  if (length(cand_k_vec) == 1 || n_eff < 4){                 
    return(list(flag_const_class = NULL, k = cand_k_vec[1]))
  } #limiting cases
    
  m_folds <- min(m_folds, n_eff)  #number of folds for internal CV
  fold_of_idx <- sample(rep(seq_len(m_folds), length.out = n_eff))
  fold <- fold_of_idx[match(orig_idx, idxs)]       # duplicates share a fold

  err <- setNames(numeric(length(cand_k_vec)), cand_k_vec)
  for (f in 1:m_folds) {
    train <- fold != f
    test <- fold == f
    if (!any(train) || !any(test)){next} #limiting case where train or test data is empty
    for (i in seq_along(cand_k_vec)){
      kk <- min(cand_k_vec[i], sum(train))                     
      p  <- class::knn(Xc[train, , drop = FALSE], Xc[test, , drop = FALSE], yc[train], k = kk)
      err[i] <- err[i] + sum(p != yc[test]) #cumulative error over all folds
    }
  }
  out <- list(flag_const_class = NULL, k = cand_k_vec[which.min(err)])
  return(out)
}
################################
##Kmeans prediction function####
################################
kmeans_pred <- function(X_un, centers){
  dist_mat <- matrix(0, nrow = nrow(X_un), ncol = nrow(centers))
  for (i in 1:nrow(centers)){
      dist_mat[,i] <- rowSums(sweep(X_un, 2, centers[i, ])^2)
  }  
  pred_center <- max.col(-dist_mat, ties.method = "first")
  return(pred_center)
}
################################
##Classifier prediction function
################################
predict_round <- function(m, Xs, classes) {
  pred_cluster <- kmeans_pred(Xs, m$km$centers)
  out <- character(nrow(Xs))
  for (j in 1:length(m$sel_k)){
    rows <- which(pred_cluster == j)
    if (!length(rows)){next}
    k_j <- m$sel_k[[j]]

    if (!is.null(k_j$flag_const_class)){out[rows] <- k_j$flag_const_class
      next
    }
    else{
      r_idx <- which(m$km$cluster == j)
      out[rows] <- as.character(class::knn(m$X[r_idx, , drop = FALSE], Xs[rows, , drop = FALSE], m$y[r_idx], k = min(k_j$k, length(r_idx))))
    }
  }
  output <- factor(out, levels = classes)
  return(output)
}

############################
######Boosting function#####
############################
boost_knn <- function(X, y, N = nrow(X), E = 50, k_grid = c(1, 5, length(unique(y)), 15, 25), m  = 10, max_restarts = 25, nstart = 5){
  #X:Nxp data matrix(standardized), y: class vector(numeric), N = number of drawn observations in resampling,
  #E: number of epochs ran, k_grid: vector of possible vals for kNN, m: parameter for internal CV
  #max_restarts:  max number of restarts in the algorithm, nstart = times kmeans is run

  X <- as.matrix(X)
  g <- factor(y)
  classes <- levels(g)
  K <- length(classes)
  rounds <- list()
  alpha <- numeric(0)

  
  for (e in 1:E){
    flag <- FALSE
    for (try in 1:max_restarts){
      if (e == 1){w <- rep(1/N, N)}

      idx_rs <- sample.int(N, replace = TRUE, prob = w)
      y_rs <- y[idx_rs]
      X_rs <- X[idx_rs, , drop  = FALSE]
      n <- length(unique(y_rs))

      if (n < 2){next}

      km_obj <- kmeans(X_rs, centers = n, nstart = nstart)

      opt_k <- vector("list", n)

      for (j in 1:n){
        r_idx <- which(km_obj$cluster == j)
        opt_k[[j]]<- select_k(X_rs[r_idx, , drop = FALSE], y_rs[r_idx], idx_rs[r_idx], k_grid, m_folds = m)
      }

      ks <- list(km = km_obj, X = X_rs, y = y_rs, sel_k = opt_k)

      miss <- as.character(predict_round(ks, X, classes)) != as.character(y)
      err <- sum(w * miss)                       # error M_e
      if (err >= 0.5){next}

      w[!miss] <- w[!miss] * err / (1 - err)    
      w <- w / sum(w)

      rounds[[length(rounds) + 1]] <- ks
      alpha <- c(alpha, log((1 - err) / err))    # voting weight
      flag <- TRUE
      break
    }
  if (!flag){
    warning("Stopped early at round ", e)
    break
    }
  }
  mod <- list(rounds = rounds, alpha = alpha, classes = classes)
  return(mod)
}
######################################
######Prediction function######
######################################
predict_knnboost <- function(model, Xnew) {
  Xs <- Xnew
  votes <- matrix(0, nrow(Xnew), length(model$classes))
  for (e in 1:length(model$rounds)){
    p <- match(as.character(predict_round(model$rounds[[e]], Xs, model$classes)),
               model$classes)
    ij <- cbind(seq_len(nrow(Xnew)), p)
    votes[ij] <- votes[ij] + model$alpha[e]      
  }
  pred <- factor(model$classes[max.col(votes, ties.method = "first")], levels = model$classes)
  return(pred)
}
